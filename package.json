{
  "name": "markdownfly",
  "version": "0.1.0",
  "description": "Markdown to PowerPoint (.pptx) CLI tool",
  "type": "module",
  "bin": {
    "mfly": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pretest": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kyvin-Guan/markdownFly.git"
  },
  "homepage": "https://github.com/Kyvin-Guan/markdownFly",
  "author": "Kyvin-Guan",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "markdown",
    "pptx",
    "powerpoint",
    "slides",
    "cli",
    "mermaid",
    "graphviz",
    "plantuml",
    "echarts"
  ],
  "dependencies": {
    "@plantuml/mcp-js": "^0.2.2",
    "@resvg/resvg-js": "^2.6.0",
    "@viz-js/viz": "^3.0.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "echarts": "^5.6.0",
    "fast-glob": "^3.3.0",
    "jsdom": "^25.0.0",
    "mermaid": "^11.0.0",
    "ora": "^8.0.0",
    "pptxgenjs": "^3.12.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^3.0.0",
    "unified": "^11.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "jszip": "^3.10.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
