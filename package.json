{
  "name": "markdownfly",
  "version": "0.1.0",
  "description": "AI-powered Markdown to PPT CLI tool",
  "type": "module",
  "bin": {
    "mfly": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "markdown",
    "pptx",
    "powerpoint",
    "slides",
    "ai",
    "cli",
    "mermaid",
    "graphviz",
    "echarts"
  ],
  "dependencies": {
    "@resvg/resvg-js": "^2.6.0",
    "@viz-js/viz": "^3.0.0",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "echarts": "^5.6.0",
    "fast-glob": "^3.3.0",
    "jsdom": "^25.0.0",
    "mermaid": "^11.0.0",
    "ora": "^8.0.0",
    "pptxgenjs": "^3.12.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^3.0.0",
    "unified": "^11.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
